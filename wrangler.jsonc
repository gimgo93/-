{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ilgok-independent-app",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "ageclan.com/app", "zone_name": "ageclan.com" },
    { "pattern": "ageclan.com/app/*", "zone_name": "ageclan.com" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
